# ----------------------------
# RPNCE makefile (CE C/C++ toolchain)
# ----------------------------

NAME = RPNCE
DESCRIPTION = "RPN calculator for the CE"
COMPRESSED = YES
ARCHIVED = YES

CFLAGS = -Wall -Wextra -Oz
CXXFLAGS = -Wall -Wextra -Oz

# Keep linker output with the other intermediate files.
TARGETOBJ = ../$(OBJDIR)/$(NAME).obj
TARGETMAP = ../$(OBJDIR)/$(NAME).map

# Sources in subfolders of src/ are picked up automatically.

# ----------------------------

include $(shell cedev-config --makefile)

# ----------------------------
# The RPNCEres appvar (menus and unit tables), built from data/RPNCEres.bin.
# data/RPNCEres.bin is generated by tools/genres.py and committed, so a
# build doesn't need Python.
# ----------------------------

RES_8XV = $(BINDIR)/RPNCEres.8xv

# built with the program, every make
$(BINDIR)/$(TARGET): $(RES_8XV)

$(RES_8XV): data/RPNCEres.bin
	$(Q)$(call MKDIR,$(@D))
	$(Q)echo [convbin] $@
	$(Q)$(CONVBIN) -r -n RPNCEres -j bin -i $< -k 8xv -o $@
